{
  "name": "mcp-thinkgate",
  "version": "0.3.0",
  "mcpName": "io.github.tjp2021/mcp-thinkgate",
  "description": "MCP server that auto-classifies prompt complexity and routes to the right Claude thinking mode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./classifier": "./dist/classifier.js",
    "./profiles": "./dist/profiles.js"
  },
  "bin": {
    "mcp-thinkgate": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "thinking",
    "router",
    "thinkgate",
    "extended-thinking",
    "reasoning",
    "selective-reasoning"
  ],
  "author": "Tim <engineering@iteachyouai.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjp2021/mcp-thinkgate.git"
  },
  "bugs": {
    "url": "https://github.com/tjp2021/mcp-thinkgate/issues"
  },
  "homepage": "https://github.com/tjp2021/mcp-thinkgate#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "lru-cache": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
